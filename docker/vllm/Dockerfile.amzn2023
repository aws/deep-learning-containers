ARG CUDA_VERSION=13.0.2
ARG PYTHON_VERSION=3.12
ARG FRAMEWORK_VERSION=0.24.0
ARG FLASHINFER_VERSION=0.6.12
# DeepEP v2 from the AWS EFA fork (amazon-contributing/DeepEP).
ARG DEEPEP_REPO=https://github.com/amazon-contributing/DeepEP.git
ARG DEEPEP_COMMIT_HASH=874779c9ccd2294b56304bd6cc5f138f1f71d097
ARG NCCL_VERSION=2.31.2
ARG NVSHMEM_PIP_VERSION=3.3.24
ARG GDRCOPY_VERSION=2.5.2

# =============================================================================
# STAGE 0: source — clone vLLM and apply patches
# =============================================================================
FROM alpine/git AS source

ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG FRAMEWORK_VERSION
ARG VLLM_REF=v${FRAMEWORK_VERSION}

RUN git clone --depth 50 --branch ${VLLM_REF} ${VLLM_REPO} /src \
  || (git clone --depth 50 ${VLLM_REPO} /src && cd /src && git fetch origin ${VLLM_REF} && git checkout ${VLLM_REF})

COPY scripts/docker/vllm/amzn2023/patches/ /tmp/patches/
# Fail hard on a patch that does not apply. The previous form ended in `; true` to tolerate
# an unmatched glob when no patches exist, but that also swallowed genuine apply failures,
# yielding a green build with an unpatched image -- detectable only by inspecting the source.
# Skip non-existent paths explicitly instead, so "no patches" stays fine and "patch is stale
# against VLLM_REF" stops the build. Matters because VLLM_REF moves.
RUN cd /src \
  && for p in /tmp/patches/*.patch; do \
       [ -f "$p" ] || continue; \
       echo "Applying $(basename "$p")"; \
       git apply --verbose "$p" || exit 1; \
     done \
  && echo "all patches applied"

# Generate source manifest
RUN echo "vLLM AL2023 Image Source Manifest" >/src/SOURCE_MANIFEST \
  && echo "Base: ${VLLM_REPO} @ ${VLLM_REF}" >>/src/SOURCE_MANIFEST \
  && echo "HEAD: $(cd /src && git rev-parse HEAD)" >>/src/SOURCE_MANIFEST \
  && echo "Built: $(date -u '+%Y-%m-%d %H:%M:%S UTC')" >>/src/SOURCE_MANIFEST \
  && echo "" >>/src/SOURCE_MANIFEST \
  && echo "Patches:" >>/src/SOURCE_MANIFEST \
  && (ls /tmp/patches/*.patch 2>/dev/null | xargs -I{} basename {} | sed 's/^/  - /' >>/src/SOURCE_MANIFEST || echo "  (none)" >>/src/SOURCE_MANIFEST) \
  && echo "" >>/src/SOURCE_MANIFEST \
  && echo "Git log:" >>/src/SOURCE_MANIFEST \
  && cd /src && git log --oneline -10 | sed 's/^/  /' >>/src/SOURCE_MANIFEST

# =============================================================================
# STAGE 1: build — compile vLLM wheel from source (or use pre-built wheel)
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-devel-amzn2023 AS build

ARG CUDA_VERSION
ARG PYTHON_VERSION
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl

RUN dnf install -y --setopt=install_weak_deps=False \
  tar gzip xz git gcc gcc-c++ make cmake ninja-build patch gawk \
  python${PYTHON_VERSION} python${PYTHON_VERSION}-devel python${PYTHON_VERSION}-pip \
  libibverbs-devel \
  && dnf clean all && rm -rf /var/cache/dnf

RUN python${PYTHON_VERSION} -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV VIRTUAL_ENV="/opt/venv"

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy

WORKDIR /workspace/vllm

# Copy source from stage 0
COPY --from=source /src/ ./

# Install PyTorch + build deps (slow-changing, cached)
RUN --mount=type=cache,target=/root/.cache/uv uv pip install -r requirements/cuda.txt -r requirements/build/cuda.txt \
  --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

# 10.3 is B300 (SM103); without it there is no SM103 cubin and no 10.0+PTX to JIT from.
# The value below is only a fallback: image configs set build.torch_cuda_arch_list, which
# resolve_build_args.py forwards verbatim (this ARG is lower-case, and Docker build args are
# case-sensitive, so the key is exempt from that script's upper-casing). It must come from the
# config rather than only from here, because the wheel cache key is computed on the CI runner
# from the config -- an arch list the runner cannot see would not invalidate a stale wheel.
ARG torch_cuda_arch_list='7.0 7.5 8.0 8.9 9.0 10.0 10.3 12.0'
ENV TORCH_CUDA_ARCH_LIST=${torch_cuda_arch_list}

ARG max_jobs=32
ENV MAX_JOBS=${max_jobs}

ARG nvcc_threads=2
ENV NVCC_THREADS=${nvcc_threads}

ENV VLLM_TARGET_DEVICE=cuda
ARG VLLM_REF
ARG FRAMEWORK_VERSION
ARG SETUPTOOLS_SCM_PRETEND_VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION:-${FRAMEWORK_VERSION}+amzn2023}

# --- Pre-built wheel support ---
# Fetch wheels from S3 into docker/vllm/prebuilt_wheels/ BEFORE docker build:
#   bash scripts/docker/vllm/amzn2023/fetch_cached_wheels.sh cu130 v0.24.0
# The directory holds only a .gitkeep by default, so COPY always succeeds -- git cannot track
# an empty directory, and without that placeholder this COPY fails on a clean clone.
COPY docker/vllm/prebuilt_wheels/ /tmp/prebuilt_wheels/

# --- Build options ---
# USE_PREBUILT_WHEEL: set to 0 to force source build even when prebuilt wheel exists
# USE_SCCACHE: set to 1 to enable sccache compilation cache
ARG USE_PREBUILT_WHEEL=1
ARG USE_SCCACHE=false

# Seed sccache cache from build context (synced from S3 before build)
COPY docker/vllm/sccache-cache/ /root/.cache/sccache/

RUN --mount=type=cache,target=/root/.cache/ccache --mount=type=cache,target=/root/.cache/uv \
    if [ "$USE_PREBUILT_WHEEL" = "1" ] && ls /tmp/prebuilt_wheels/*.whl >/dev/null 2>&1; then \
      echo "✅ Using pre-built vLLM wheel — skipping compilation" \
      && rm -rf dist && mkdir -p dist \
      && cp /tmp/prebuilt_wheels/*.whl dist/; \
    elif [ "$USE_SCCACHE" = "true" ]; then \
      echo "🔧 Building vLLM with sccache..." \
      && curl -L -o /tmp/sccache.tar.gz \
        "https://github.com/mozilla/sccache/releases/download/v0.8.1/sccache-v0.8.1-x86_64-unknown-linux-musl.tar.gz" \
      && tar -xzf /tmp/sccache.tar.gz -C /tmp \
      && mv /tmp/sccache-v0.8.1-x86_64-unknown-linux-musl/sccache /usr/bin/sccache \
      && rm -rf /tmp/sccache* \
      && export SCCACHE_DIR=/root/.cache/sccache \
      && export SCCACHE_IDLE_TIMEOUT=0 \
      && export SCCACHE_LOG=warn \
      && export CMAKE_BUILD_TYPE=Release \
      && export CMAKE_C_COMPILER_LAUNCHER=sccache \
      && export CMAKE_CXX_COMPILER_LAUNCHER=sccache \
      && export CMAKE_CUDA_COMPILER_LAUNCHER=sccache \
      && sccache --show-stats \
      && python3 setup.py bdist_wheel --dist-dir=dist --py-limited-api=cp38 \
      && sccache --show-stats; \
    else \
      echo "🔧 Building vLLM from source (no sccache)..." \
      && python3 setup.py bdist_wheel --dist-dir=dist --py-limited-api=cp38; \
    fi

# Build the DeepEP wheel from the AWS EFA fork. Its setup.py compiles both the legacy NVSHMEM
# backend and the NCCL/GIN (EFA) backend and finds them from pip-wheel metadata / EP_NCCL_ROOT_DIR,
# so install those wheels first, then build into the dist dir the runtime stage copies from.
ARG DEEPEP_REPO
ARG DEEPEP_COMMIT_HASH
ARG NCCL_VERSION
ARG NVSHMEM_PIP_VERSION
RUN --mount=type=cache,target=/root/.cache/uv CUDA_MAJOR=$(echo $CUDA_VERSION | cut -d. -f1) \
  && uv pip install --no-deps \
    "nvidia-nccl-cu${CUDA_MAJOR}==${NCCL_VERSION}" \
    "nvidia-nvshmem-cu${CUDA_MAJOR}==${NVSHMEM_PIP_VERSION}" \
  && git clone "${DEEPEP_REPO}" /tmp/deepep \
  && git -C /tmp/deepep checkout "${DEEPEP_COMMIT_HASH}" \
  && git -C /tmp/deepep submodule update --init --recursive \
  && mkdir -p /tmp/ep_kernels_workspace/dist \
  && cd /tmp/deepep \
  && EP_NCCL_ROOT_DIR="/opt/venv/lib/python${PYTHON_VERSION}/site-packages/nvidia/nccl" \
    LIBRARY_PATH="/opt/venv/lib/python${PYTHON_VERSION}/site-packages/nvidia/nccl/lib:/usr/local/cuda/lib64/stubs:/usr/local/cuda/targets/x86_64-linux/lib/stubs:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="/opt/venv/lib/python${PYTHON_VERSION}/site-packages/nvidia/nccl/lib:${LD_LIBRARY_PATH}" \
    DISABLE_AGGRESSIVE_PTX_INSTRS=1 \
    TORCH_CUDA_ARCH_LIST='9.0a 10.0a 10.3a' \
    python3 setup.py bdist_wheel --dist-dir /tmp/ep_kernels_workspace/dist \
  && cd / && rm -rf /tmp/deepep

ARG GDRCOPY_VERSION
RUN mkdir -p /tmp/gdrcopy && cd /tmp \
  && curl --retry 3 -fsSL -o v${GDRCOPY_VERSION}.tar.gz \
    https://github.com/NVIDIA/gdrcopy/archive/refs/tags/v${GDRCOPY_VERSION}.tar.gz \
  && tar -xzf v${GDRCOPY_VERSION}.tar.gz && rm v${GDRCOPY_VERSION}.tar.gz \
  && cd gdrcopy-${GDRCOPY_VERSION} \
  && make -j"$(nproc)" prefix=/usr/local CUDA=/usr/local/cuda lib lib_install \
  && cd / && rm -rf /tmp/gdrcopy*

# =============================================================================
# STAGE: wheel-export — scratch image with built wheels for S3 cache upload
# Usage: docker buildx build --target wheel-export --output type=local,dest=./wheels ...
# =============================================================================
FROM scratch AS wheel-export
COPY --from=build /workspace/vllm/dist/ /wheels/

# =============================================================================
# STAGE: sccache-export — extract sccache cache for S3 upload
# Usage: docker buildx build --target sccache-export --output type=local,dest=./sccache-out ...
# =============================================================================
FROM scratch AS sccache-export
COPY --from=build /root/.cache/sccache/ /

# =============================================================================
# STAGE 2: deps — clean venv with only runtime packages
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-devel-amzn2023 AS deps

ARG CUDA_VERSION
ARG PYTHON_VERSION
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl

RUN dnf install -y --setopt=install_weak_deps=False \
  tar gzip gcc gcc-c++ \
  python${PYTHON_VERSION} python${PYTHON_VERSION}-devel python${PYTHON_VERSION}-pip \
  libibverbs-devel \
  && dnf clean all && rm -rf /var/cache/dnf

RUN python${PYTHON_VERSION} -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV VIRTUAL_ENV="/opt/venv"

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy

# Match runtime venv NCCL to the DeepEP wheel's compile-time NCCL (see build stage).
# Pin transformers < 5.16: vLLM 0.29.0 predates the 5.16 Pixtral rename + rope_parameters changes.
ARG NCCL_VERSION
RUN CUDA_MAJOR=$(echo $CUDA_VERSION | cut -d. -f1) \
  && echo "nvidia-nccl-cu${CUDA_MAJOR}==${NCCL_VERSION}" >/etc/uv-overrides.txt \
  && echo "transformers==5.15.1" >>/etc/uv-overrides.txt
ENV UV_OVERRIDE=/etc/uv-overrides.txt

# Install PyTorch
COPY --from=build /workspace/vllm/requirements/common.txt /tmp/common.txt
COPY --from=build /workspace/vllm/requirements/cuda.txt /tmp/cuda.txt
RUN --mount=type=cache,target=/root/.cache/uv uv pip install -r /tmp/cuda.txt \
  --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

# Install vLLM wheel
COPY --from=build /workspace/vllm/dist /tmp/vllm-dist
RUN --mount=type=cache,target=/root/.cache/uv ls /tmp/vllm-dist/*.whl \
  && VLLM_WHL=$(ls -t /tmp/vllm-dist/vllm-*.whl | head -1) \
  && echo "Installing ${VLLM_WHL}" \
  && uv pip install "${VLLM_WHL}" \
    --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

# Install FlashInfer jit-cache after vllm wheel (pin both flashinfer-python and
# flashinfer-jit-cache to ensure version match for flashinfer download-cubin)
ARG FLASHINFER_VERSION
RUN --mount=type=cache,target=/root/.cache/uv uv pip install \
  flashinfer-python==${FLASHINFER_VERSION} flashinfer-jit-cache==${FLASHINFER_VERSION} \
  --extra-index-url https://flashinfer.ai/whl/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

# Install serving extras
RUN --mount=type=cache,target=/root/.cache/uv uv pip install accelerate modelscope \
  "bitsandbytes>=0.46.1" "timm>=1.0.17" "runai-model-streamer[s3,gcs,azure]>=0.15.7"

# Audio deps for voxtral / ASR serving (mistral_common is an optional import in vLLM 0.24.0)
RUN --mount=type=cache,target=/root/.cache/uv uv pip install \
  av scipy soundfile "mistral_common[audio]"

ARG NVSHMEM_PIP_VERSION
RUN --mount=type=cache,target=/root/.cache/uv CUDA_MAJOR=$(echo $CUDA_VERSION | cut -d. -f1) \
  && uv pip install --no-deps "nvidia-nvshmem-cu${CUDA_MAJOR}==${NVSHMEM_PIP_VERSION}"

# Install DeepEP wheels from build stage
COPY --from=build /tmp/ep_kernels_workspace/dist /tmp/ep_kernels/dist
RUN --mount=type=cache,target=/root/.cache/uv \
  if ls /tmp/ep_kernels/dist/*.whl >/dev/null 2>&1; then \
    uv pip install /tmp/ep_kernels/dist/*.whl; \
  else \
    echo "No DeepEP wheels to install; skipping."; \
  fi && rm -rf /tmp/ep_kernels

# Install KV connectors (lmcache, nixl) if requested
ARG INSTALL_KV_CONNECTORS=true
COPY --from=source /src/requirements/kv_connectors.txt /tmp/kv_connectors.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    CUDA_MAJOR="${CUDA_VERSION%%.*}"; \
    CUDA_DASH=$(echo $CUDA_VERSION | cut -d. -f1,2 | tr '.' '-'); \
    if [ "$INSTALL_KV_CONNECTORS" = "true" ]; then \
        uv pip install -r /tmp/kv_connectors.txt --no-build || ( \
            dnf install -y --setopt=install_weak_deps=False \
                libcusparse-devel-${CUDA_DASH} \
                libcublas-devel-${CUDA_DASH} \
                libcusolver-devel-${CUDA_DASH} \
            && uv pip install -r /tmp/kv_connectors.txt --no-build-isolation \
            && dnf remove -y libcusparse-devel-${CUDA_DASH} libcublas-devel-${CUDA_DASH} libcusolver-devel-${CUDA_DASH} \
            && dnf clean all && rm -rf /var/cache/dnf \
        ); \
        if [ "$CUDA_MAJOR" -ge 13 ]; then \
            uv pip install --force-reinstall --no-deps nixl-cu13; \
        fi; \
    fi

# Download FlashInfer precompiled cubins after all pip installs are done
RUN flashinfer show-config && flashinfer download-cubin

# =============================================================================
# STAGE: builder-oss — generates license files without modifying runtime venv
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-runtime-amzn2023 AS builder-oss
ARG PYTHON_VERSION
RUN dnf install -y --allowerasing python${PYTHON_VERSION} curl && dnf clean all
COPY --from=deps /opt/venv /opt/venv
COPY scripts/docker/common/setup_oss_compliance.sh /tmp/setup_oss_compliance.sh
RUN PATH="/opt/venv/bin:${PATH}" bash /tmp/setup_oss_compliance.sh python${PYTHON_VERSION} \
  && touch /root/THIRD_PARTY_SOURCE_CODE_URLS

# =============================================================================
# STAGE 3: runtime — minimal image with clean venv
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-runtime-amzn2023 AS runtime

ARG CUDA_VERSION
ARG PYTHON_VERSION=3.12

WORKDIR /vllm-workspace

RUN dnf install -y --setopt=install_weak_deps=False \
  python${PYTHON_VERSION} libibverbs shadow-utils tar gzip \
  && dnf clean all && rm -rf /var/cache/dnf

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Runtime JIT compilation tools (Triton/Inductor, FlashInfer)
RUN CUDA_DASH=$(echo $CUDA_VERSION | cut -d. -f1,2 | tr '.' '-') \
  && dnf install -y --setopt=install_weak_deps=False \
    gcc python${PYTHON_VERSION}-devel \
    cuda-nvcc-${CUDA_DASH} \
    cuda-cudart-devel-${CUDA_DASH} \
    cuda-nvrtc-${CUDA_DASH} \
    cuda-cuobjdump-${CUDA_DASH} \
    libcurand-devel-${CUDA_DASH} \
    libcublas-${CUDA_DASH} \
    numactl-libs \
  && dnf clean all && rm -rf /var/cache/dnf

COPY --from=deps /opt/venv /opt/venv
COPY --from=source /src/SOURCE_MANIFEST /vllm-workspace/

ENV PATH="/opt/venv/bin:${PATH}"
ENV VIRTUAL_ENV="/opt/venv"
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV VLLM_USAGE_SOURCE=production-docker-image
ENV HF_XET_HIGH_PERFORMANCE=1

# =============================================================================
# STAGE 4: DLC overlay — Amazon DLC customizations on top of vLLM runtime
# =============================================================================
FROM runtime AS base

ARG PYTHON="python3"
ARG PYTHON_VERSION=3.12
ARG CUDA_VERSION
ARG DLC_MAJOR_VERSION=2
ARG DLC_MINOR_VERSION=1

LABEL maintainer="Amazon AI"
LABEL dlc_major_version="${DLC_MAJOR_VERSION}"
LABEL dlc_minor_version="${DLC_MINOR_VERSION}"

ENV LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  DLC_CONTAINER_TYPE=general \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PYTHONIOENCODING=UTF-8 \
  LD_LIBRARY_PATH="/opt/amazon/ofi-nccl/lib64:/opt/amazon/openmpi/lib64:/opt/amazon/efa/lib64:/usr/local/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}" \
  PATH="/opt/amazon/openmpi/bin:/opt/amazon/efa/bin:/usr/local/cuda/bin:${PATH}"

WORKDIR /

# Install DLC Python dependencies
RUN uv pip install --no-cache-dir botocore instanttensor modelexpress

# Patch CVEs
RUN uv pip install --no-cache-dir \
  "pillow>=12.1.1" \
  "xgrammar>=0.1.32" \
  "PyJWT>=2.12.0" \
  "cbor2>=5.9.0" \
  "starlette>=1.3.1" \
  "cryptography>=48.0.1" \
  "model-hosting-container-standards>=0.1.16,<1.0.0" \
  # 8.0.1 fixes AttributeError on fastapi 0.138 _IncludedRouter that 500s /health (instrumentator #371)
  "prometheus-fastapi-instrumentator>=8.0.1"

COPY ./scripts/docker/telemetry/deep_learning_container.py /usr/local/bin/deep_learning_container.py
COPY ./scripts/docker/telemetry/bash_telemetry.sh.template /tmp/bash_telemetry.sh.template

ARG FRAMEWORK
ARG FRAMEWORK_VERSION
ARG CONTAINER_TYPE

# telemetry
RUN chmod +x /usr/local/bin/deep_learning_container.py \
  && sed -e "s/{{FRAMEWORK}}/${FRAMEWORK}/g" \
    -e "s/{{FRAMEWORK_VERSION}}/${FRAMEWORK_VERSION}/g" \
    -e "s/{{CONTAINER_TYPE}}/${CONTAINER_TYPE}/g" \
    /tmp/bash_telemetry.sh.template >/usr/local/bin/bash_telemetry.sh \
  && chmod +x /usr/local/bin/bash_telemetry.sh \
  && rm /tmp/bash_telemetry.sh.template \
  && echo 'source /usr/local/bin/bash_telemetry.sh' >>/etc/bashrc \
  && echo 'source /usr/local/bin/bash_telemetry.sh' >>/root/.bashrc \
  && ln -sf /opt/venv/bin/python3 /usr/bin/python \
  && rm -rf /tmp/tmp* \
  && rm -rf /tmp/uv* \
  && rm -rf /var/cache/dnf \
  && rm -rf /root/.cache || true

# OSS compliance (runs in isolated stage to avoid polluting the venv)
COPY --from=builder-oss /root/THIRD_PARTY_SOURCE_CODE_URLS /root/THIRD_PARTY_SOURCE_CODE_URLS
COPY --from=builder-oss /root/PYTHON_PACKAGES_LICENSES /root/PYTHON_PACKAGES_LICENSES
COPY --from=builder-oss /root/LINUX_PACKAGES_LICENSES /root/LINUX_PACKAGES_LICENSES
COPY --from=builder-oss /root/BUILD_FROM_SOURCE_PACKAGES_LICENCES /root/BUILD_FROM_SOURCE_PACKAGES_LICENCES
COPY --from=builder-oss /usr/local/bin/testOSSCompliance /usr/local/bin/testOSSCompliance

COPY --from=build /usr/local/lib/libgdrapi.so* /usr/local/lib/

# install EFA
COPY ./scripts/docker/common/install_efa_amzn2023.sh install_efa_amzn2023.sh
ARG EFA_VERSION="1.50.0"
RUN echo -e '[cuda-rhel9]\nname=cuda-rhel9\nbaseurl=https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64\nenabled=1\ngpgcheck=1' >/etc/yum.repos.d/cuda-rhel9.repo \
  && dnf install -y --setopt=install_weak_deps=False libnccl libnccl-devel \
  && ldconfig \
  && bash install_efa_amzn2023.sh ${EFA_VERSION} \
  && rm install_efa_amzn2023.sh \
  && dnf remove -y libnccl-devel \
  && dnf clean all && rm -rf /var/cache/dnf \
  && rm -rf /usr/local/cuda/bin/nvdisasm*

# Prebuild all_reduce_perf so the CI EFA test's setup_nccl_tests.sh is a no-op.
ARG NCCL_TESTS_VERSION=v2.20.0
RUN dnf install -y --setopt=install_weak_deps=False make gcc-c++ \
  && NCCL_HOME=$(/opt/venv/bin/python -c "import nvidia.nccl; print(nvidia.nccl.__path__[0])") \
  && if [ ! -e "${NCCL_HOME}/lib/libnccl.so" ]; then \
       ln -s "$(basename $(ls ${NCCL_HOME}/lib/libnccl.so.* | head -1))" "${NCCL_HOME}/lib/libnccl.so"; \
     fi \
  && cd /tmp \
  && NCCL_TESTS_DIR="/tmp/nccl-tests-${NCCL_TESTS_VERSION#v}" \
  && curl -fsSL "https://github.com/NVIDIA/nccl-tests/archive/refs/tags/${NCCL_TESTS_VERSION}.tar.gz" | tar xz \
  && make -C "${NCCL_TESTS_DIR}/src" BUILDDIR="${NCCL_TESTS_DIR}/build" \
       MPI=1 MPI_HOME=/opt/amazon/openmpi NCCL_HOME="${NCCL_HOME}" CUDA_HOME=/usr/local/cuda \
       NVCC_GENCODE="-gencode=arch=compute_80,code=sm_80 -gencode=arch=compute_90,code=sm_90" \
       CXXSTD="-std=c++17" \
       "${NCCL_TESTS_DIR}/build/all_reduce_perf" \
  && cp "${NCCL_TESTS_DIR}/build/all_reduce_perf" /usr/local/bin/all_reduce_perf \
  && dnf remove -y make gcc-c++ && dnf clean all && rm -rf /var/cache/dnf \
  && cd / && rm -rf "${NCCL_TESTS_DIR}"

# ====================== ec2 =========================================
FROM base AS vllm-ec2-amzn2023

ARG CACHE_REFRESH=0
RUN dnf upgrade -y --security --releasever latest --setopt=install_weak_deps=False \
  && dnf upgrade -y --releasever latest cuda-compat-13-0 \
  && dnf clean all && rm -rf /var/cache/dnf /tmp/* \
  # dnf needs system python 3.9
  && ln -sf /opt/venv/bin/python3 /usr/bin/python3

COPY ./scripts/docker/vllm/dockerd_entrypoint.sh /usr/local/bin/dockerd_entrypoint.sh
RUN chmod +x /usr/local/bin/dockerd_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/dockerd_entrypoint.sh"]

# ====================== sagemaker =========================================
FROM base AS vllm-sagemaker-amzn2023

ARG CACHE_REFRESH=0
RUN dnf upgrade -y --security --releasever latest --setopt=install_weak_deps=False \
  && dnf upgrade -y --releasever latest cuda-compat-13-0 \
  && dnf install -y --setopt=install_weak_deps=False libsndfile \
  && dnf clean all && rm -rf /var/cache/dnf /tmp/* \
  # dnf needs system python 3.9
  && ln -sf /opt/venv/bin/python3 /usr/bin/python3

COPY ./scripts/docker/vllm/sagemaker_entrypoint.sh /usr/local/bin/sagemaker_entrypoint.sh
COPY ./scripts/docker/vllm/sagemaker_serve.py /usr/local/bin/sagemaker_serve.py
COPY ./scripts/docker/vllm/sagemaker_args.py /usr/local/bin/sagemaker_args.py
RUN chmod +x /usr/local/bin/sagemaker_entrypoint.sh
ENV PYTHONPATH="/usr/local/bin:${PYTHONPATH}"

ENTRYPOINT ["/usr/local/bin/sagemaker_entrypoint.sh"]

