# Hugging Face PyTorch inference DLC, layered on the matching AWS PyTorch DLC.
# BASE_IMAGE selects the matching SageMaker image through the image configuration.
ARG BASE_IMAGE=public.ecr.aws/deep-learning-containers/pytorch:2.11.0-cu130-amzn2023-sagemaker

FROM ${BASE_IMAGE} AS base

ARG DLC_MAJOR_VERSION=1
ARG DLC_MINOR_VERSION=0
ARG FRAMEWORK=huggingface-pytorch-inference
ARG FRAMEWORK_VERSION=2.11.0
ARG CONTAINER_TYPE=inference
ARG TRANSFORMERS_VERSION=5.20.2
ARG HF_SERVE_VERSION=0.2.0
ARG DIFFUSERS_VERSION=0.42.0
ARG VENV_PYTHON=/opt/venv/bin/python

LABEL maintainer="Hugging Face"
LABEL dlc_major_version="${DLC_MAJOR_VERSION}"
LABEL dlc_minor_version="${DLC_MINOR_VERSION}"
LABEL framework="${FRAMEWORK}"
LABEL framework_version="${FRAMEWORK_VERSION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PYTHONIOENCODING=UTF-8 \
  VIRTUAL_ENV=/opt/venv \
  DLC_CONTAINER_TYPE=${CONTAINER_TYPE}

# The base already provides CUDA 13.0, PyTorch 2.11, and the shared venv.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# SPAL provides the audio runtime dependencies on Amazon Linux 2023.
RUN dnf upgrade -y --releasever=latest --setopt=install_weak_deps=False system-release \
  && dnf install -y spal-release \
  && dnf install -y --setopt=install_weak_deps=False \
    espeak-ng \
    ffmpeg-free \
    file-libs \
    git \
  && dnf clean all \
  && rm -rf /var/cache/dnf

# Security constraints for transitive dependencies:
# aiohttp: CVE-2026-111064, CVE-2026-111066, GHSA-2g87-pp6c-29x5
# anyio: GHSA-82r6-8w77-94w6
# brotli: CVE-2026-111497, GHSA-9v8h-qqgm-4m35
# certifi: GHSA-6q48-6c7w-9gw2
# cryptography: CVE-2026-69247
# filelock: CVE-2026-112940
# mlflow: CVE-2026-53995
# fsspec: CVE-2026-104851 (s3fs must upgrade with its matching fsspec pin)
# pillow: CVE-2026-112895, CVE-2026-112896, CVE-2026-112897,
# CVE-2026-112397, CVE-2026-112400, CVE-2026-112403, CVE-2026-112404
# gitpython: CVE-2026-87817, CVE-2026-114145
# graphql-core: CVE-2026-75507, CVE-2026-75508
# tornado: CVE-2026-82397
# urllib3: CVE-2026-97687, CVE-2026-97689
RUN uv pip install --python ${VENV_PYTHON} \
  "hf-serve[cuda-130]==${HF_SERVE_VERSION}" \
  "torch==${FRAMEWORK_VERSION}" \
  "diffusers==${DIFFUSERS_VERSION}" \
  "transformers[accelerate,audio,chat_template,kernels,video,vision]==${TRANSFORMERS_VERSION}" \
  "aiohttp>=3.14.4" \
  "anyio>=4.14.2" \
  "certifi>=2026.10.19" \
  "cryptography>=50.0.0" \
  "brotli>=1.2.1" \
  "filelock>=4.2.1" \
  "mlflow>=3.17.2" \
  "fsspec[http]>=2026.6.0" \
  "s3fs>=2026.6.0" \
  "pillow>=13.0.0" \
  "gitpython>=3.2.1" \
  "graphql-core>=3.2.12,<3.3" \
  "tornado>=6.5.8" \
  "urllib3>=2.8.0" \
  && uv cache clean \
  && rm -rf /tmp/uv*

# Re-template telemetry so the image reports the Hugging Face inference framework.
COPY ./scripts/docker/telemetry/deep_learning_container.py /usr/local/bin/deep_learning_container.py
COPY ./scripts/docker/telemetry/bash_telemetry.sh.template /tmp/bash_telemetry.sh.template
RUN chmod +x /usr/local/bin/deep_learning_container.py \
  && sed -e "s/{{FRAMEWORK}}/${FRAMEWORK}/g" \
    -e "s/{{FRAMEWORK_VERSION}}/${FRAMEWORK_VERSION}/g" \
    -e "s/{{CONTAINER_TYPE}}/${CONTAINER_TYPE}/g" \
    /tmp/bash_telemetry.sh.template >/usr/local/bin/bash_telemetry.sh \
  && chmod +x /usr/local/bin/bash_telemetry.sh \
  && rm /tmp/bash_telemetry.sh.template

COPY ./scripts/docker/common/setup_oss_compliance.sh /tmp/setup_oss_compliance.sh
RUN bash /tmp/setup_oss_compliance.sh python3 \
  && rm /tmp/setup_oss_compliance.sh \
  && rm -rf /root/oss_compliance* /tmp/tmp* /root/.cache

ARG CACHE_REFRESH=0
RUN echo "cache refresh: ${CACHE_REFRESH}" \
  && dnf upgrade -y --security --releasever latest \
  && dnf clean all \
  && rm -rf /var/cache/dnf

COPY --chmod=755 ./scripts/docker/huggingface/pytorch/inference/entrypoint.sh /usr/local/bin/hf_serve_entrypoint.sh

EXPOSE 8080
WORKDIR /workspace

# =====================================================================
# sagemaker — Hugging Face PyTorch inference for SageMaker AI
# =====================================================================
FROM base AS sagemaker

ENV CLOUD=sagemaker \
  HF_HUB_USER_AGENT_ORIGIN="aws:sagemaker:gpu-cuda:inference:hf-pytorch"

LABEL com.amazonaws.sagemaker.capabilities.accept-bind-to-port=true
LABEL com.amazonaws.sagemaker.capabilities.multi-models=false

COPY --chmod=755 ./scripts/docker/huggingface/pytorch/inference/sagemaker_entrypoint.sh /usr/local/bin/sagemaker_entrypoint.sh
ENTRYPOINT ["/usr/local/bin/sagemaker_entrypoint.sh"]
CMD ["serve"]